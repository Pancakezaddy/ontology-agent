    pets:hasAntiBid pets:AffectionWithdrawnEarly ;
    pets:showsWarning pets:TailLash, pets:EarsBack, pets:Freeze, pets:WalkAway, pets:GrowlHiss, pets:OverstimulationBite ;
    pets:escalatesWhenAffectionWithdrawnEarly pets:Clawing, pets:GentleBiting, pets:HeavyingBody, pets:ResistingDisplacement, pets:DesperateClawing ;
    pets:stopsDemandingAttentionVia pets:MidbodyLaunchProtocol, pets:VerbalSettleProtocol ;
    pets:hasCessationRepetitionsMin 3 ;
    pets:hasCessationRepetitionsMax 5 ;
    pets:enjoysPlayActivity pets:BeingLaunched, pets:HuntOfDespair .

pets:Salem a pets:Cat ;
    rdfs:label "Salem" ;
    rdfs:comment "A specific female cat, five years old, with black coat color. She readily presents her belly. She loves vigorous belly rubs and light chin and cheek scratches. She is warm and affectionate when she comes out of her bat cave. Biggest motivations are the feather wand toy and Temptations treats. She can be found scaling Christmas trees and loves swinging around the cat-tree pole. She typically needs at least six hours to warm up to people unless a tub of Temptations is shaken. Bids include sprawling on a person's lap." ;
